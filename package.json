{
  "name": "ng-demo",
  "author": "Matt Raible <mraible@gmail.com>",
  "version": "22.0.0",
  "license": "MIT",
  "main": "main.js",
  "build": {
    "appId": "bare.bones.angular",
    "productName": "Bare Bones Angular",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "main.js",
      "dist/ng-demo/browser/**/*",
      "!node_modules/**/*"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cy:run": "concurrently -k -s first \"ng serve\" \"cypress run\"",
    "electron": "ng build && electron .",
    "pack": "ng build && electron-builder --dir",
    "dist": "ng build && electron-builder"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@cypress/schematic": "6.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "concurrently": "10.0.6",
    "cypress": "16.2.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
